{
  "version": 1,
  "resources": {
    "gbAlbedo":   { "format": "R8G8B8A8_Unorm",     "size": { "relative": 1.0 } },
    "gbNormal":   { "format": "R16G16B16A16_Float", "size": { "relative": 1.0 } },
    "gbLightMask": { "format": "R32_Uint",          "size": { "relative": 1.0 } },
    "depth":      { "format": "D32_Float",          "size": { "relative": 1.0 }, "clear": { "depth": 1.0 } },
    "shadowMap":  { "format": "D32_Float",          "size": { "width": 2048, "height": 2048 }, "clear": { "depth": 1.0 } },
    "sceneColor": { "format": "R16G16B16A16_Float", "size": { "relative": 1.0 } }
  },
  "passes": [
    { "name": "Shadow", "type": "Raster", "pipeline": "pipelines/materials/standard.shadow.json", "view": "shadow",
      "constants": [ { "source": "object", "bind": { "param": 0 } },
                     { "source": "frame",  "bind": { "param": 1 } } ],
      "outputs": [ { "res": "shadowMap", "as": "DSV", "load": "clear" } ],
      "content": { "drawList": { "layer": "Shadow" } } },
    { "name": "GBuffer", "type": "Raster", "pipeline": "pipelines/gbuffer.json",
      "constants": [ { "source": "object", "bind": { "param": 0 } },
                     { "source": "frame",  "bind": { "param": 1 } } ],
      "outputs": [ { "res": "gbAlbedo", "as": "RTV0", "load": "clear" },
                   { "res": "gbNormal", "as": "RTV1", "load": "clear" },
                   { "res": "gbLightMask", "as": "RTV2", "load": "clear" },
                   { "res": "depth",    "as": "DSV",  "load": "clear" } ],
      "content": { "drawList": { "layer": "Opaque" } } },
    { "name": "Lighting", "type": "Raster", "pipeline": "pipelines/lighting.json",
      "constants": [ { "source": "frame",  "bind": { "param": 0 } },
                     { "source": "lights", "bind": { "param": 2 } } ],
      "inputs":  [ { "res": "gbAlbedo", "as": "SRV", "bind": { "param": 1, "offset": 0 } },
                   { "res": "gbNormal", "as": "SRV", "bind": { "param": 1, "offset": 1 } },
                   { "res": "depth",    "as": "SRV", "bind": { "param": 1, "offset": 2 } },
                   { "res": "gbLightMask", "as": "SRV", "bind": { "param": 1, "offset": 3 } },
                   { "res": "shadowMap", "as": "SRV", "bind": { "param": 1, "offset": 4 } } ],
      "outputs": [ { "res": "sceneColor", "as": "RTV0", "load": "dontCare" } ],
      "content": { "fullscreen": true } },
    { "name": "Grid", "type": "Raster", "pipeline": "pipelines/grid.json",
      "constants": [ { "source": "frame", "bind": { "param": 0 } } ],
      "inputs":  [ { "res": "depth", "as": "DSVRead" } ],
      "outputs": [ { "res": "sceneColor", "as": "RTV0", "load": "load" } ],
      "content": { "drawList": { "layer": "Grid" } } },
    { "name": "Composite", "type": "Raster", "pipeline": "pipelines/composite.json",
      "constants": [ { "source": "frame", "bind": { "param": 0 } } ],
      "inputs":  [ { "res": "sceneColor", "as": "SRV", "bind": { "param": 1, "offset": 0 } } ],
      "outputs": [ { "res": "$backbuffer", "as": "RTV0", "load": "dontCare" } ],
      "content": { "fullscreen": true } }
  ]
}
